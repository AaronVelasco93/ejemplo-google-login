{
  "name": "ejemplo/google-login-pdo",
  "description": "Ejemplo educativo de autenticación con Google OAuth 2.0, PDO y variables de entorno.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "google/apiclient": ">=2.18 <3.0",
    "vlucas/phpdotenv": ">=5.6 <6.0"
  },
  "autoload": {
    "psr-4": {
      "Example\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
